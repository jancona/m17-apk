#!/bin/sh
# m17-web runs as its own user. dialout: it identifies the radio HAT on
# the serial port (with the gateway stopped).
addgroup -S m17-web 2>/dev/null
adduser -S -D -H -h /var/lib/m17-web -s /sbin/nologin -G m17-web \
	-g "M17 hotspot web UI" m17-web 2>/dev/null
addgroup m17-web dialout 2>/dev/null
exit 0
