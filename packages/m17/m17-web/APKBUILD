# Maintainer: Jim Ancona, N1ADJ <jancona@users.noreply.github.com>
pkgname=m17-web
_commit=4889ec2ac262b212c590a953ea7e915627f3b35d
pkgver=0_git20261125
pkgrel=1
pkgdesc="Web UI (setup wizard, later admin pages and dashboard) for M17 hotspots running m17-hotspot-os"
# Renamed from m17-admin (2026-11). A hotspot gets it with its next OS
# release; the old package keeps its files until then.
replaces="m17-admin"
url="https://github.com/jancona/m17-web"
arch="aarch64"
license="Apache-2.0"
# It shares rpi-dashboard's admin password, and its root actions go
# through m17-hotspot-os's admin helper (with the image's doas rule)
depends="rpi-dashboard doas"
makedepends="go"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-openrc"
source="$pkgname-$_commit.tar.gz::https://github.com/jancona/m17-web/archive/$_commit.tar.gz
	m17-web.initd
	"
builddir="$srcdir/$pkgname-$_commit"
# The build downloads Go modules (and the Go version go.mod asks for, with
# GOTOOLCHAIN=auto), checked against the Go checksum database
options="net"

export GOTOOLCHAIN=auto
export GOFLAGS="$GOFLAGS -trimpath -mod=readonly -modcacherw"
export CGO_ENABLED=0

build() {
	go build -ldflags "-s -w" -o m17-web ./cmd/m17-web
}

check() {
	go test ./...
}

package() {
	install -Dm755 m17-web "$pkgdir"/usr/bin/m17-web
	install -Dm755 "$srcdir"/m17-web.initd "$pkgdir"/etc/init.d/m17-web
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	# The Go toolchain fetched by GOTOOLCHAIN=auto is unpacked read-only
	chmod -R u+w "$(go env GOMODCACHE)" 2>/dev/null || true
}

sha512sums="
458caf9ed7d16d166704f11314d06b9fcb5e35e90ec6a68d901f625de00ea0797a99b933cb676111c63b84915c589d98fe98836f7d06794b61318888991d572c  m17-web-4889ec2ac262b212c590a953ea7e915627f3b35d.tar.gz
f2be8443f8daa967419341caa4d8bdd3a52df6af6b8be8718106e2ab3ad3267733e1ef6bdec48fc8d8054816138945b4cf8207e812e905a52d0b3b3bdeda0f35  m17-web.initd
"
