pkgdesc="MMDVM_HS hotspot firmware with M17 (MMDVM_HS_Hat, MMDVM_HS_Dual_Hat, generic GPIO boards)"
url="https://github.com/M17-Project/MMDVM_HS"
arch="noarch"
license="GPL-2.0-or-later"
source="
	MMDVM_HS_Hat.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/MMDVM_HS_Hat.bin
	MMDVM_HS_Hat-12mhz.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/MMDVM_HS_Hat-12mhz.bin
	MMDVM_HS_Dual_Hat.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/MMDVM_HS_Dual_Hat.bin
	MMDVM_HS_Dual_Hat-12mhz.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/MMDVM_HS_Dual_Hat-12mhz.bin
	generic_gpio.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/generic_gpio.bin
	generic_duplex_gpio.bin::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/release/generic_duplex_gpio.bin
	$pkgname-LICENCE::https://raw.githubusercontent.com/M17-Project/MMDVM_HS/$_commit/LICENCE
	"
options="!check !archcheck !strip !tracedeps"  # prebuilt firmware for the HAT's microcontroller, not for the Pi

package() {
	install -Dm644 "$srcdir"/MMDVM_HS_Hat.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/MMDVM_HS_Hat.bin
	install -Dm644 "$srcdir"/MMDVM_HS_Hat-12mhz.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/MMDVM_HS_Hat-12mhz.bin
	install -Dm644 "$srcdir"/MMDVM_HS_Dual_Hat.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/MMDVM_HS_Dual_Hat.bin
	install -Dm644 "$srcdir"/MMDVM_HS_Dual_Hat-12mhz.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/MMDVM_HS_Dual_Hat-12mhz.bin
	install -Dm644 "$srcdir"/generic_gpio.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/generic_gpio.bin
	install -Dm644 "$srcdir"/generic_duplex_gpio.bin "$pkgdir"/usr/share/m17-firmware/mmdvm_hs/generic_duplex_gpio.bin
	install -Dm644 "$srcdir"/$pkgname-LICENCE "$pkgdir"/usr/share/licenses/$pkgname/LICENCE
}

