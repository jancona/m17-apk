package() {
	install -Dm644 "$srcdir"/Repeater-Builder_v3.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/Repeater-Builder_v3.bin
	install -Dm644 "$srcdir"/Repeater-Builder_v4.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/Repeater-Builder_v4.bin
	install -Dm644 "$srcdir"/Repeater-Builder_v5.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/Repeater-Builder_v5.bin
	install -Dm644 "$srcdir"/Repeater-Builder_MTR2K_v3-405.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/Repeater-Builder_MTR2K_v3-405.bin
	install -Dm644 "$srcdir"/Repeater-Builder_MTR2K_v3-446.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/Repeater-Builder_MTR2K_v3-446.bin
	install -Dm644 "$srcdir"/MMDVM_RPT_Hat_0.2.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/MMDVM_RPT_Hat_0.2.bin
	install -Dm644 "$srcdir"/MMDVM_RPT_Hat_0.3.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/MMDVM_RPT_Hat_0.3.bin
	install -Dm644 "$srcdir"/ZUM_MMDVM-Pi_0.9-F4.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/ZUM_MMDVM-Pi_0.9-F4.bin
	install -Dm644 "$srcdir"/ZUM_MMDVM-Pi_1.0-F4.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/ZUM_MMDVM-Pi_1.0-F4.bin
	install -Dm644 "$srcdir"/ZUM_MMDVM-Pi_1.0-F7.bin "$pkgdir"/usr/share/m17-firmware/mmdvm/ZUM_MMDVM-Pi_1.0-F7.bin
	install -Dm644 "$srcdir"/F446RE.elf "$pkgdir"/usr/share/m17-firmware/mmdvm/F446RE.elf
	install -Dm644 "$srcdir"/F767ZI.elf "$pkgdir"/usr/share/m17-firmware/mmdvm/F767ZI.elf
	install -Dm644 "$srcdir"/$pkgname-LICENCE "$pkgdir"/usr/share/licenses/$pkgname/LICENCE
}

