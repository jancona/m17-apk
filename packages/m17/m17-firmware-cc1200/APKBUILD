pkgname=m17-firmware-cc1200
pkgver=2.3
pkgrel=0
pkgdesc="Firmware for the M17 CC1200 HAT"
url="https://github.com/M17-Project/CC1200_HAT-fw"
arch="noarch"
license="GPL-3.0-only"
source="
	CC1200_HAT-fw-$pkgver.bin::https://github.com/M17-Project/CC1200_HAT-fw/releases/download/v$pkgver/CC1200_HAT-fw.bin
	$pkgname-LICENSE::https://raw.githubusercontent.com/M17-Project/CC1200_HAT-fw/v$pkgver/LICENSE
	"
options="!check !archcheck !strip !tracedeps"  # prebuilt firmware for the HAT's microcontroller, not for the Pi

package() {
	install -Dm644 "$srcdir"/CC1200_HAT-fw-$pkgver.bin "$pkgdir"/usr/share/m17-firmware/cc1200/CC1200_HAT-fw.bin
	install -Dm644 "$srcdir"/$pkgname-LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

